<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VelaShell.Core\VelaShell.Core.csproj" />
    <!-- 插件契约程序集。取 nuget.org 上的正式包,版本 = 根 Directory.Build.props 的
         VelaSdkVersion(由 joesdu/velashell-plugin-toolchain 发布)。 -->
    <PackageReference Include="VelaShell.PluginSdk" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="MaxMind.Db" />
    <PackageReference Include="SonnetDB.Core" />
    <!-- SSH/SFTP。**不是 nuget 包,而是 external/Tmds.Ssh 这个 submodule 的工程引用** ——
         X11 转发(x11-req + 远端 x11 channel)只在 Aecric/Tmds.Ssh 的 feature/x11-forwarding
         分支上,上游 0.24.0 与 nuget 上都没有那套 API,而 fork 没有 nuget.org 的发布权限。
         submodule 钉死在一个提交上,CI 与别人的机器 clone 下来编出的是同一份 —— 既不用猜
         一个还不存在的版本号,也不用造本地包(那两条都被 AGENTS.md 明令禁止)。
         上游合并或 fork 发包之后:改回 PackageReference、把 PackageVersion 抬到那一版、
         删掉 submodule 与 external/Directory.Build.targets。 -->
    <ProjectReference Include="..\..\external\Tmds.Ssh\src\Tmds.Ssh\Tmds.Ssh.csproj" />
    <!-- DPAPI(CurrentUser)包裹本地 AES 密钥文件;仅 Windows 运行时可用,其余平台已代码守卫。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <!-- 见 VelaShell.Terminal.csproj 同处注释:签名构建(Release)省略友元声明,非签名构建保留。
       本项目的友元是 VelaShell.Core.Tests(Tmds.Ssh 包装类与异常翻译的白盒测试放在那边)。 -->
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="VelaShell.Core.Tests" />
    <InternalsVisibleTo Include="VelaShell.Infrastructure.Tests" />
  </ItemGroup>

</Project>
